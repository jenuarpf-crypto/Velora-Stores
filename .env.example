# URL pública final, sin slash al final. Ej: https://velora.co
BASE_URL=http://localhost:3000
PORT=3000

# Datos visibles de la tienda
STORE_NAME=VELORA
STORE_EMAIL=ventas@tudominio.com
STORE_WHATSAPP=573001234567
STORE_CITY=Medellín, Colombia
LEGAL_NAME=COMPLETAR RAZON SOCIAL
NIT=COMPLETAR NIT

# Envío, en COP. Deja 0 para envío incluido/gratis.
SHIPPING_FEE_COP=0

# Wompi - primero usa llaves de Sandbox.
# Producción: pub_prod_, prv_prod_, prod_integrity_, prod_events_
WOMPI_PUBLIC_KEY=pub_test_REEMPLAZAR
WOMPI_PRIVATE_KEY=prv_test_REEMPLAZAR
WOMPI_INTEGRITY_SECRET=test_integrity_REEMPLAZAR
WOMPI_EVENTS_SECRET=test_events_REEMPLAZAR

# Token largo para el panel /admin.html
ADMIN_TOKEN=CAMBIAR-POR-UN-TOKEN-LARGO-Y-ALEATORIO
